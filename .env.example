# Twilio Credentials for Outbound PSTN & AI Voice Calls
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=+12345678901

# Whitelisted E.164 phone numbers permitted to receive calls (comma-separated or * for all)
ALLOWED_NUMBERS=*

# Groq API Key for AI Voice Agent
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public Tunnel URL when running locally (e.g. from 'ngrok http 5173')
# Required for Twilio cloud to reach your local webhook during live phone testing!
# If deployed on Netlify/Vercel, you can leave this blank (auto-detected).
PUBLIC_URL=https://your-subdomain.ngrok-free.app

